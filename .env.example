# --- PostgreSQL (Docker) ---
POSTGRES_USER=cinema_owner
POSTGRES_PASSWORD=owner_pass_123
POSTGRES_DB=cinema_booking

# --- Mat khau 3 role (nen dat don gian, khong dung ky tu dac biet) ---
ROLE_ADMIN_PASSWORD=admin_pass_123
ROLE_STAFF_PASSWORD=staff_pass_123
ROLE_CUSTOMER_PASSWORD=customer_pass_123

# --- Chuoi ket noi cho tung role (chay tren may, DB o localhost) ---
DATABASE_URL="postgresql://role_admin:admin_pass_123@localhost:5432/cinema_booking"
DATABASE_URL_ADMIN="postgresql://role_admin:admin_pass_123@localhost:5432/cinema_booking"
DATABASE_URL_STAFF="postgresql://role_nhan_vien:staff_pass_123@localhost:5432/cinema_booking"
DATABASE_URL_CUSTOMER="postgresql://role_khach_hang:customer_pass_123@localhost:5432/cinema_booking"

# --- Chi dung de chay migration (khong dung trong code ung dung) ---
MIGRATION_DATABASE_URL="postgresql://cinema_owner:owner_pass_123@localhost:5432/cinema_booking"

PORT=3000